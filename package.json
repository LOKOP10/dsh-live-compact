{
  "name": "dsh-live-compact",
  "version": "1.1.0",
  "description": "In-place newest-turn compaction for DeepSeek Harness. Compress while the task runs and keep the prefix.",
  "license": "MIT",
  "author": "MerkyorLynn <268568828+MerkyorLynn@users.noreply.github.com>",
  "type": "module",
  "main": "shell.js",
  "bin": {
    "dsh-live-compact": "bin/dsh-live-compact.js"
  },
  "exports": {
    ".": "./shell.js",
    "./engine": "./index.js",
    "./gate": "./gate.js",
    "./shadow-search": "./shadow-search.js"
  },
  "files": [
    "shell.js",
    "adapter.js",
    "index.js",
    "gate.js",
    "plan.js",
    "raw.js",
    "shadow.js",
    "shadow-search.js",
    "cooldown.js",
    "thunder.js",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "compaction"
  ],
  "scripts": {
    "test:gate": "node test/p0-gate.mjs && node test/p0-blockers.mjs && node --test test/cooldown.test.mjs test/gate-config.test.mjs test/drain-stopline.mjs test/scan-once.mjs test/issue-19.mjs"
  },
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-compaction": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-compaction-basic": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-compaction": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MerkyorLynn/dsh-live-compact.git"
  },
  "homepage": "https://github.com/MerkyorLynn/dsh-live-compact#readme",
  "bugs": {
    "url": "https://github.com/MerkyorLynn/dsh-live-compact/issues"
  }
}
